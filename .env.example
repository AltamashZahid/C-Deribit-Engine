# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Testnet keys: https://test.deribit.com -> Account -> API -> Add new key (scopes: trade:read_write, account:read)

DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# Optional (defaults shown)
# DERIBIT_HOST=test.deribit.com
# DERIBIT_PORT=443
# DERIBIT_BOOK_INTERVAL=100ms        # "raw" needs authentication
# DERIBIT_CA_FILE=                   # PEM bundle; default: OS trust store
# MD_SERVER_BIND=127.0.0.1
# MD_SERVER_PORT=8080
# MD_SERVER_THREADS=2
# MD_SERVER_MAX_QUEUE=256
# LOG_FILE=deribit_engine.log
# LOG_LEVEL=info                     # debug | info | warn | error | off
# CONSOLE_LOG_LEVEL=warn
# HEARTBEAT_SECONDS=10
# REQUEST_TIMEOUT_MS=5000
# ORDER_RATE_PER_SEC=5               # client-side limit for buy/sell/edit/cancel
# ORDER_BURST=10
# RPC_RATE_PER_SEC=20                # everything else
# RPC_BURST=50
